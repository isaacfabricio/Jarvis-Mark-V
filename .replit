modules = ["python-3.12", "nodejs-24"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Jarvis Mark V"

[[workflows.workflow]]
name = "Jarvis Mark V"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python cerebro_api.py"
waitForPort = 8000

[workflows.workflow.metadata]
outputType = "webview"

[nix]
channel = "stable-25_05"
packages = ["SDL2", "SDL2_image", "SDL2_mixer", "SDL2_ttf", "cargo", "fontconfig", "freetype", "geckodriver", "gitFull", "glibcLocales", "libGL", "libGLU", "libiconv", "libjpeg", "libpng", "libxcrypt", "openssl", "pkg-config", "playwright-driver", "portmidi", "rustc", "scrot", "xsimd", "xvfb-run"]

[[ports]]
localPort = 8000
externalPort = 80
